  "statistical_plan": {
    "primary_estimand": "Unconditional fresh-pair-verified recovery probability within 300.0s cutoff",
    "secondary_estimand": "Full offline and online resource accounting (wall seconds, solver seconds, verification seconds, candidate attempts)",
    "confidence_interval": "Wilson 95% score interval",
    "primary_paired_contrast": {
      "contrast_id": "primary_contrast_neural_screened_vs_sat_only_all_obs",
      "method_a": "hierarchical_neural_screened",
      "method_b": "sat_only_all_observations",
      "test": "Exact two-sided paired McNemar test",
      "alpha": 0.05,
      "rationale": "Directly evaluates whether neural guidance provides an advantage over unguided SAT under strict observation parity (128 observations available to both methods; 4 encoded into formula for neural vs 128 in unguided formula) on the common pycryptosat backend and common 300.0s resource envelope."
    },
    "multiplicity_control": {
      "method": "Holm-Bonferroni step-down procedure",
      "family_wise_alpha": 0.05,
      "adjusted_secondary_contrasts": [
        {
          "contrast_id": "secondary_contrast_1_neural_vs_hybrid",
          "method_a": "hierarchical_neural_screened",
          "method_b": "hierarchical_neural_classical",
          "test": "Exact two-sided paired McNemar test"
        },
        {
          "contrast_id": "secondary_contrast_2_neural_vs_random",
